{
  "rewrites": [
    {
      "source": "/royaldevelopers",
      "destination": "/royaldevelopers/index.html"
    },
    {
      "source": "/royaldevelopers/",
      "destination": "/royaldevelopers/index.html"
    },
    {
      "source": "/royaldevelopers/projects/:slug",
      "destination": "/royaldevelopers/projects/:slug/index.html"
    },
    {
      "source": "/royaldevelopers/services/:slug",
      "destination": "/royaldevelopers/services/:slug/index.html"
    },
    {
      "source": "/royaldevelopers/:path*",
      "destination": "/royaldevelopers/:path*/index.html"
    },
    {
      "source": "/store/:id",
      "destination": "/api/share?store=:id"
    },
    {
      "source": "/b/:id",
      "destination": "/api/share?banter=:id"
    },
    {
      "source": "/prediction/:team/:match/:pick",
      "destination": "/api/share?m=:match&p=:pick"
    },
    {
      "source": "/shareprediction/:kind/:code",
      "destination": "/api/share?c=:code"
    },
    {
      "source": "/share/table",
      "destination": "/api/share?view=table"
    },
    {
      "source": "/share/fixtures",
      "destination": "/api/share?view=fixtures"
    },
    {
      "source": "/share/cleansheets",
      "destination": "/api/share?view=cleansheets"
    },
    {
      "source": "/share/team/:team",
      "destination": "/api/share?team=:team"
    }
  ]
}
